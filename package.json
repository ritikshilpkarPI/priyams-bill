  "scripts": {
    "local-dev": "nodemon server/app.js",
    "dev": "nodemon --exec npm run restart",
    "restart": "rimraf dist && npm run build && npm run start",
    "start": "cross-env ENV_NAME=dev npm-run-all --parallel start:server start:app",
    "client": "export SET NODE_OPTIONS=--openssl-legacy-provider && react-scripts start ",
    "server": "export SET NODE_OPTIONS=--openssl-legacy-provider && netlify-lambda serve server -t 500",
    "build": "export SET NODE_OPTIONS=--openssl-legacy-provider && npm run build:functions & npm run build:app",
    "build:app": "react-scripts build",
    "debug": "netlify dev --inspect",
    "build:functions": "netlify-lambda build server",
    "test": "react-scripts test --env=jsdom",
    "format": "git diff --name-only HEAD | grep '\\.jsx$' | xargs prettier --write", 
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScreenRecorderApp/screenrecorder-app.git"
  },
